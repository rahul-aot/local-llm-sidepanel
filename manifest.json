{
  "manifest_version": 3,
  "name": "LocalMind - Local LLM Side Panel",
  "version": "1.0.0",
  "description": "Browser Side Panel extension to chat with local LLMs (Ollama / LM Studio), persistent session memory miner, and full context exporter.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.*/*",
    "http://10.*/*",
    "*://*/*"
  ],
  "action": {
    "default_title": "Open LocalMind Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
